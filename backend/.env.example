# =============================================
# .env.example - 팀원 공유용 환경변수 템플릿
# 이 파일을 복사해서 .env 로 만들고 실제 값을 채워주세요
# cp .env.example .env
# =============================================

# --- 실행 환경 (local 또는 real) ---
SPRING_PROFILES_ACTIVE=local

# --- MariaDB (Local) ---
LOCAL_DB_URL=jdbc:mariadb://localhost:3306/navi_log_analyzer?useSSL=false&characterEncoding=UTF-8&serverTimezone=Asia/Seoul
DB_DRIVER=org.mariadb.jdbc.Driver
LOCAL_DB_USERNAME=your_username
LOCAL_DB_PASSWORD=your_password