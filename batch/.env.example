# ===============================================
# .env.example - 팀원 공유용 환경변수 탬플릿
# 이 파일을 복사해서 .env 로 만들고 실제 값을 채워주세요
# cp .env.example .envs
# ===============================================

# --- Loacl (MariaDB) ---
DB_URL=jdbc:mariadb://localhost:3306/navi_log_analyzer
DB_DRIVER=org.mariadb.jdbc.Driver
DB_USERNAME=your_username
DB_PASSWORD=your_password